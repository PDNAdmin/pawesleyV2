{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/studio-build/static/:path*"
    },
    {
      "source": "/studio",
      "destination": "/studio-build/index.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/studio-build/index.html"
    }
  ]
}