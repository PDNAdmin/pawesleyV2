{
  "name": "memorial-film",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.jsx",
    "render": "remotion render src/index.jsx Memorial ../assets/film/memorial.mp4 --codec h264 --crf 20",
    "render:vertical": "remotion render src/index.jsx MemorialVertical ../assets/film/memorial-vertical.mp4 --codec h264 --crf 21",
    "poster": "remotion still src/index.jsx Memorial ../assets/film/memorial-poster.jpg --frame 240 --image-format jpeg --jpeg-quality 86"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.537",
    "@remotion/google-fonts": "^4.0.537",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.537"
  }
}
